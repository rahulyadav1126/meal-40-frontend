{
  "name": "plate40-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:customer": "npm run dev --workspace=@plate40/customer-web",
    "dev:dashboard": "npm run dev --workspace=@plate40/dashboard-web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
